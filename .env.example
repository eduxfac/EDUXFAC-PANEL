# Preparación Fase 1. Configurar mediante entorno del proceso; no se conecta automáticamente.
PANEL_WEB_SERVICE_BASE_URL=
PANEL_WEB_SERVICE_SECRET=EJEMPLO_FALSO_NO_USAR_SECRET_PANEL_WEB
PANEL_WEB_SERVICE_ISSUER=panel-eduxfac-ejemplo
PANEL_WEB_SERVICE_AUDIENCE=eduxfac-web-admin-ejemplo

# Fase 6: desactivados por defecto. Intervalo mínimo de 60000 ms.
INTEGRATION_WORKER_ENABLED=false
INTEGRATION_WORKER_INTERVAL_MS=60000
EXPIRATION_WORKER_ENABLED=false
EXPIRATION_WORKER_INTERVAL_MS=60000
RECONCILIATION_WORKER_ENABLED=false
RECONCILIATION_WORKER_INTERVAL_MS=300000
MAX_INTEGRATION_RETRIES=5
# Autoriza mutaciones del worker WEB solo tras revisión de base y migraciones.
EDUXFAC_SUBSCRIPTION_WORKER_ALLOW_MUTATION=no

# FASE 8: SQLite solo transición/local. Producción exige postgres, HTTPS y TLS verificado.
PANEL_DB_ENGINE=sqlite
PANEL_DATABASE_URL=
PANEL_PG_TLS=verify-full
PANEL_DB_STATEMENT_TIMEOUT_MS=10000
PANEL_SESSION_TTL_MS=28800000
PANEL_PUBLIC_ORIGIN=https://admin.eduxfac.com
PANEL_HSTS_ENABLED=false
PANEL_BACKUP_RETENTION_COUNT=14
# Herramientas F8 solo laboratorio: NODE_ENV=test y PANEL_F8_ISOLATED=yes explícitos.
# Nunca poner credenciales reales en esta plantilla.
